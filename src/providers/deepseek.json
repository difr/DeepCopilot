{
  "$schema": "./_schema.json",
  "id": "deepseek",
  "displayName": "DeepSeek",
  "baseUrl": "https://api.deepseek.com",
  "apiKeyUrl": "https://platform.deepseek.com/api_keys",
  "protocol": "openai",
  "defaultModel": "deepseek-v4-pro",
  "subAgentModel": "deepseek-flash",
  "pricingPolicy": {
    "offPeakDiscount": {
      "multiplier": 0.5,
      "timezone": "Asia/Shanghai",
      "peakWindows": [
        { "weekdays": [1, 2, 3, 4, 5], "from": "09:00", "to": "12:00" },
        { "weekdays": [1, 2, 3, 4, 5], "from": "14:00", "to": "18:00" }
      ]
    }
  },
  "quirks": {
    "streamOptions": true,
    "parallelTools": true,
    "useMaxCompletionTokens": false,
    "balanceEndpoint": "/user/balance",
    "reasoningField": "reasoning_content",
    "stripInputFields": ["reasoning_content"]
  },
  "models": [
    {
      "id": "deepseek-v4-pro",
      "displayName": "DeepSeek V4 Pro",
      "contextWindow": 1000000,
      "maxOutputTokens": 384000,
      "capabilities": { "tools": true, "reasoning": true, "vision": false },
      "pricing": {
        "currency": "CNY",
        "input": 9.0,
        "cache_hit": 0.3,
        "output": 27.0
      }
    },
    {
      "id": "deepseek-flash",
      "displayName": "DeepSeek V4.1 Flash",
      "contextWindow": 1000000,
      "maxOutputTokens": 384000,
      "capabilities": { "tools": true, "reasoning": true, "vision": true },
      "pricing": {
        "currency": "CNY",
        "input": 2.0,
        "cache_hit": 0.04,
        "output": 8.0
      }
    }
  ]
}
