# VCS / project config
.gitignore
.gitleaksignore
.eslintrc.json
.github/**
.deep-copilot/**
**/.git/**

# Package output / logs
*.vsix
session-*.log
**/*.map
release/**
# Local PR-review scratch caches (GH API dumps); must never ship in the VSIX
.tmp-*.json
.tmp-*.txt
.tmp-*.md

# Sources (esbuild bundles them into out/)
src/**
esbuild.config.js
node_modules/**

# Docs (README.md stays for the Marketplace)
**/*.md
!README.md

# Misc scripts / tools
scripts/**
refine-logs/**
dangerfile.js
commitlint.config.mjs

# Test examples
demo_test/**

# Local scratch. tmp/ holds a reference checkout, and one of its entries is a directory
# without an extension: vsce 3.x runs secretlint over every packaged path, reads it as a
# file and aborts with EISDIR before the VSIX is written.
tmp/**
